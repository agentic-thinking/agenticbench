# AgenticBench rig: operator configuration. Copy to rig.conf (git-ignored) and edit. Every value below is a fictional example.
# bench/unit.sh reads rig.conf from the repository root, or the file named by RIG_CONF.

# Model provider for third-party-backend harnesses. The harness talks plain HTTP to the rig's capture proxy with a random
# dummy key; the proxy swaps in your key and forwards over HTTPS to MODEL_UPSTREAM. The key file stays outside the repo and
# is mounted read-only into the proxy container only, never into a harness container.
MODEL_KEYFILE=/path/outside/the/repo/model-api-key
MODEL_UPSTREAM=api.model-provider.example
MODEL_ID=example-model-1
MODEL_OPENAI_PATH=/v1               # OpenAI-compatible base path on the upstream (chat completions; Responses API for Codex)
MODEL_ANTHROPIC_PATH=/anthropic     # Anthropic-compatible base path on the upstream (Claude Code only)

# Vendor-hosted harnesses (amp, auggie, cursor, gemini): the model is served by the harness vendor and your own account is needed.
#   <harness>_MODEL_RE   regex on host+path matching that harness's model requests in the capture (required to run it)
#   <harness>_CRED_FILE  your credential file; read by you, piped into the container and copied into its in-memory HOME only
#                        (default: the same path under your own HOME as the harness uses in the container)
#amp_MODEL_RE='^model\.vendor-a\.example/api/'
#amp_CRED_FILE=/path/to/your/credential.json
#auggie_MODEL_RE='^api\.vendor-b\.example/model'
#   <harness>_MODEL_ID   the model the adapter selects explicitly (cursor, gemini; see the adapter for its default), recorded in run.json
#   <harness>_STREAM     opt-in, regex on host+path: flows the capture streams through instead of buffering (bidirectional
#                        streams, needed by cursor; see METHOD.md), recorded in run.json
#cursor_MODEL_RE='^agent\.vendor-c\.example/agent\.v1\.AgentService/'
#cursor_STREAM='^agent\.vendor-c\.example/agent\.v1\.AgentService/'
#cursor_CRED_FILE=/path/to/your/cursor/auth.json
#cursor_MODEL_ID=example-model-1
# Gemini CLI keeps a key entered in its own dialog encrypted per host, so the rig reads your own API key from a JSON file you
# prepare outside the repository (mode 600): {"GEMINI_API_KEY": "..."}. It is copied into the in-memory HOME and read into the
# environment per step, never put on a command line.
#gemini_MODEL_RE='^api\.vendor-d\.example/'
#gemini_CRED_FILE=/path/outside/the/repo/gemini-key.json
#gemini_MODEL_ID=example-model-1

# Vendor account and billing errors (optional, any harness). A headless or resume step whose stdout or stderr holds a known
# vendor error (out of credits, quota exceeded, rate limit, plan does not allow the model, not logged in or session expired,
# payment required) does not count as worked. The built-in list is bench/lib/vendor_errors.py; add harness-specific wording here.
#   <harness>_ERROR_RE   case-insensitive regex, matched per line of the step's output; recorded in each unit's run.json
#amp_ERROR_RE='keep using vendor-a'

# Optional safety block, OFF by default. Apart from the fixed QUIC rule (UDP 443 is rejected for every harness so that traffic
# falls back to inspectable TCP, see METHOD.md), the rig never blocks or alters a harness's traffic unless you set this.
#   <harness>_BLOCK      regex on host+path; matching requests are answered 503 locally, captured and never forwarded.
# Use it only to keep test data out of your real account. It changes what is measured: the rule is written to each
# unit's run.json and must be reported with any result that used it.
#amp_BLOCK='^files\.vendor-a\.example/'
